    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
