{
  "name": "@y7-feedback/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@y7-feedback/config": "workspace:*",
    "@y7-feedback/domain": "workspace:*",
    "appwrite": "26.2.0",
