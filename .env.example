# Public Vite configuration (safe identifiers only)
VITE_Y7_ENVIRONMENT=development
VITE_APPWRITE_ENVIRONMENT=development
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=replace-with-non-production-project-id
VITE_API_ENDPOINT=http://localhost:8787/
VITE_RELEASE=local

# Trusted Function configuration (set secret values outside source control)
Y7_ENVIRONMENT=development
APPWRITE_ENVIRONMENT=development
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=replace-with-non-production-project-id
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=feedback
APPWRITE_WORKSPACES_TABLE_ID=workspaces
APPWRITE_WORKSPACE_MEMBERSHIPS_TABLE_ID=workspace_memberships
APPWRITE_PROJECT_ASSIGNMENTS_TABLE_ID=project_assignments
APPWRITE_PROJECT_SLUGS_TABLE_ID=project_slugs
APPWRITE_PROJECTS_TABLE_ID=projects
APPWRITE_REPORTERS_TABLE_ID=reporters
APPWRITE_FEEDBACK_TABLE_ID=feedback
APPWRITE_LIFECYCLE_TABLE_ID=feedback_lifecycle
APPWRITE_ACCESS_GRANTS_TABLE_ID=access_grants
APPWRITE_NOTIFICATIONS_TABLE_ID=notifications
APPWRITE_NOTIFICATION_SIGNALS_TABLE_ID=notification_signals
APPWRITE_OUTBOX_TABLE_ID=notification_outbox
APPWRITE_IDEMPOTENCY_TABLE_ID=intake_idempotency
APPWRITE_ATTACHMENT_BUCKET_ID=private_attachments
APPWRITE_ATTACHMENT_STAGING_TABLE_ID=attachment_staging
APPWRITE_ATTACHMENTS_TABLE_ID=attachments
APPWRITE_PROVIDER_GRANTS_TABLE_ID=provider_grants
APPWRITE_SOURCE_CONNECTIONS_TABLE_ID=source_connections
APPWRITE_ADMINISTRATION_AUDIT_TABLE_ID=administration_audit
APPWRITE_ADMINISTRATION_IDEMPOTENCY_TABLE_ID=administration_idempotency
APPWRITE_CONVERSATION_MESSAGES_TABLE_ID=conversation_messages
APPWRITE_CONVERSATION_INTERNAL_NOTES_TABLE_ID=conversation_internal_notes
APPWRITE_CONVERSATION_IDEMPOTENCY_TABLE_ID=conversation_idempotency
APPWRITE_CONVERSATION_LIFECYCLE_TABLE_ID=conversation_lifecycle
APPWRITE_PUBLICATION_CONSENTS_TABLE_ID=publication_consents
APPWRITE_EXTERNAL_ISSUE_LINKS_TABLE_ID=external_issue_links
APPWRITE_PROVIDER_OUTBOX_TABLE_ID=provider_outbox
APPWRITE_PROVIDER_EVENT_INBOX_TABLE_ID=provider_event_inbox
APPWRITE_PROVIDER_SYNC_OUTBOX_TABLE_ID=provider_sync_outbox
APPWRITE_OFFLINE_CONFLICT_PROJECTIONS_TABLE_ID=offline_conflict_projections
APPWRITE_INTELLIGENCE_PROVENANCE_TABLE_ID=intelligence_provenance
APPWRITE_DELETION_RECORDS_TABLE_ID=deletion_records
APPWRITE_ABUSE_COUNTERS_TABLE_ID=abuse_counters
APPWRITE_EXCEPTIONAL_ACCESS_GRANTS_TABLE_ID=exceptional_access_grants
APPWRITE_EXCEPTIONAL_ACCESS_AUDIT_TABLE_ID=exceptional_access_audit
APPWRITE_EXCEPTIONAL_ACCESS_OPERATIONS_TABLE_ID=exceptional_access_operations
# Platform exceptional access remains disabled unless all three values are set.
APPWRITE_PLATFORM_OPERATOR_TEAM_ID=platform_operators
APPWRITE_PLATFORM_OWNER_TEAM_ID=platform_owners
PLATFORM_MFA_MAX_AGE_SECONDS=300
# 32 random bytes encoded as unpadded base64url; configure outside Git.
ACCESS_PROOF_ENVELOPE_KEY=
# A different 32-byte base64url key dedicated to provider grants.
PROVIDER_GRANT_ENVELOPE_KEY=
# Active identifier and JSON keyring for application-level sensitive-data envelopes.
# Every value is a distinct 32-byte unpadded base64url key; retain old keys for reads.
SENSITIVE_DATA_ACTIVE_KEY_ID=data_YYYY_MM
ABUSE_HMAC_ACTIVE_KEY_ID=abuse_YYYY_MM
ABUSE_HMAC_KEYS={"abuse_YYYY_MM":"replace-with-32-byte-base64url-key"}
SENSITIVE_DATA_ENVELOPE_KEYS={"data_YYYY_MM":""}
# Provider OAuth values are environment-specific and server-only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=https://function-preview.example.test/providers/github/callback
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CALLBACK_URL=https://function-preview.example.test/providers/gitlab/callback
GITLAB_OAUTH_ORIGIN=https://gitlab.com/
# SMTP delivery authority. Preview points to the mail catcher; Production points
# to the approved transactional provider. Recipient addresses are resolved from
# Appwrite at delivery time and are never placed in Function variables.
Y7_EMAIL_SMTP_HOST=smtp.example.test
Y7_EMAIL_SMTP_PORT=587
Y7_EMAIL_SMTP_SECURE=false
Y7_EMAIL_SMTP_USER=
Y7_EMAIL_SMTP_PASSWORD=
Y7_EMAIL_FROM=Y7 Feedback <no-reply@example.test>
# Private ClamAV gateway authority. Keep the 32-byte HMAC key server-only.
ANTIVIRUS_SCANNER_ENDPOINT=https://scanner-preview.example.test
ANTIVIRUS_SCANNER_KEY_ID=preview_YYYY_MM
ANTIVIRUS_SCANNER_HMAC_KEY=
ANTIVIRUS_SCANNER_TIMEOUT_MS=8000
RELEASE=local

# Synthetic probe configuration
Y7_PROBE_ROOT_URL=http://localhost:4173/
Y7_PROBE_HEALTH_URL=http://localhost/health

# Deployed Preview Function ingress fitness probe
Y7_INGRESS_PROBE_URL=http://localhost/operational/ingress-probe
Y7_FUNCTION_DOMAIN_URL=https://function-preview.example.test
