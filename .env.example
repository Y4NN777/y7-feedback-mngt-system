# Public Vite configuration (safe identifiers only)
VITE_Y7_ENVIRONMENT=development
VITE_APPWRITE_ENVIRONMENT=development
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=replace-with-non-production-project-id
VITE_RELEASE=local

# Trusted Function configuration (set secret values outside source control)
Y7_ENVIRONMENT=development
APPWRITE_ENVIRONMENT=development
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=replace-with-non-production-project-id
APPWRITE_API_KEY=
RELEASE=local

# Synthetic probe configuration
Y7_PROBE_ROOT_URL=http://localhost:4173/
Y7_PROBE_HEALTH_URL=http://localhost/health

# Deployed Function ingress fitness probe (authorization stays outside Git)
Y7_INGRESS_PROBE_URL=http://localhost/ingress-probe
Y7_INGRESS_PROBE_AUTHORIZATION=
