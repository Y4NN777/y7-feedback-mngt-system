{
  "name": "y7-feedback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @y7-feedback/config build && pnpm --filter @y7-feedback/domain build && pnpm --filter @y7-feedback/api build && pnpm --filter @y7-feedback/web build",
    "dev": "pnpm --filter @y7-feedback/web dev",
    "format": "prettier --write \"apps/**/*.{html,json,ts,tsx,css}\" \"functions/**/*.{json,ts}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{json,js,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{html,json,ts,tsx,css}\" \"functions/**/*.{json,ts}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"*.{json,js,yaml}\"",
    "lint": "eslint . --max-warnings 0",
    "probe": "node scripts/probe.mjs",
    "probe:ingress": "node scripts/ingress-probe.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "test": "node --test tests/*.test.mjs && pnpm -r --if-present test",
    "test:coverage": "node --test tests/*.test.mjs && pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm --filter @y7-feedback/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
