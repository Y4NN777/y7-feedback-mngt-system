{
  "name": "@y7-feedback/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./public": {
      "types": "./src/public.ts",
      "default": "./dist/public.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
