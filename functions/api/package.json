{
  "name": "@y7-feedback/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/storage-blob": "^12.33.0",
    "@y7-feedback/config": "workspace:*",
    "@y7-feedback/domain": "workspace:*",
    "node-appwrite": "27.1.0",
    "nodemailer": "^9.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "provision:appwrite": "node dist/provision-appwrite.js --apply",
    "verify:appwrite:g1": "node dist/verify-appwrite-g1.js --apply",
    "verify:appwrite:g2:attachments": "node dist/verify-appwrite-g2-attachment.js --apply",
    "verify:appwrite:g3:conversation-lifecycle": "node dist/verify-appwrite-g3-conversation-lifecycle.js --apply",
    "verify:appwrite:g3:workbench": "node dist/verify-appwrite-g3-workbench.js --apply",
    "verify:appwrite:g3:notifications": "node dist/verify-appwrite-g3-workbench.js --apply",
    "verify:appwrite:g3:composed": "node dist/verify-appwrite-g3-composed.js --apply",
    "verify:appwrite:g4:platform-access": "node dist/verify-appwrite-g4-platform-access.js --apply",
    "verify:appwrite:d4:migration": "node dist/verify-appwrite-d4-migration.js --apply",
    "verify:appwrite:antivirus": "node dist/verify-appwrite-antivirus.js --apply",
    "verify:appwrite:direct-access": "node dist/verify-appwrite-direct-access.js --apply",
    "verify:appwrite:workspace-operations": "node dist/verify-appwrite-workspace-operations.js --apply",
    "verify:mail-catcher": "node dist/verify-preview-mail-catcher.js",
    "verify:mail:g3": "node dist/verify-preview-mail-catcher.js",
    "verify:source-provider": "node dist/verify-preview-source-provider.js",
    "verify:recovery:g5": "node dist/verify-recovery-g5.js --apply",
    "recovery:backup": "node dist/run-recovery-backup.js --apply",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "appwrite": "26.2.0"
  }
}
