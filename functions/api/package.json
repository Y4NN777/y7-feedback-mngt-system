{
  "name": "@y7-feedback/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@y7-feedback/config": "workspace:*",
    "@y7-feedback/domain": "workspace:*",
    "node-appwrite": "27.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "provision:appwrite": "node dist/provision-appwrite.js --apply",
    "verify:appwrite:g1": "node dist/verify-appwrite-g1.js --apply",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
